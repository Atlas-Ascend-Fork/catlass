}

//--- all.mlir
module {
  tla.func @all_pipe() {
    "tla.cube"() ({
      %mutex = tla.mutex "res" {id = 1 : i64} -> !tla.mutex
      tla.mutex_lock %mutex [#tla.pipe<all>] : !tla.mutex
      tla.mutex_unlock %mutex [#tla.pipe<all>] : !tla.mutex
    }) : () -> ()
    tla.return
  }
}
