      tla.mutex_lock %mutex [#tla.pipe<fix>] : !tla.mutex
      tla.mutex_unlock %mutex [#tla.pipe<fix>] : !tla.mutex
    }) : () -> ()
    tla.return
  }
}

//--- mte1-on-vector.mlir
module {
  tla.func @mte1_pipe_on_vector() {
    "tla.vector"() ({
      %mutex = tla.mutex "res" {id = 1 : i64} -> !tla.mutex
      tla.mutex_lock %mutex [#tla.pipe<mte1>] : !tla.mutex
      tla.mutex_unlock %mutex [#tla.pipe<mte1>] : !tla.mutex
